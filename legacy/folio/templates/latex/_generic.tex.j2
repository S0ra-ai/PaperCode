{# Generic single-column LaTeX template; safe fallback when no venue
   class file is available. Uses biblatex with the style hint provided
   by the FormatSpec.                                                #}
\documentclass[{{ font_size_pt }}pt,{{ paper }}paper{% if columns == 2 %},twocolumn{% endif %}]{article}

\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage[
  top={{ margins.top_mm }}mm,
  bottom={{ margins.bottom_mm }}mm,
  left={{ margins.left_mm }}mm,
  right={{ margins.right_mm }}mm
]{geometry}
\usepackage{graphicx}
\usepackage{amsmath, amssymb}
\usepackage{hyperref}
{% if has_bibliography %}
\usepackage[backend=biber, style={{ biblatex_style }}]{biblatex}
\addbibresource{references.bib}
{% endif %}

\title{ {{ draft.title | latex_escape }} }
\author{ {{ author | latex_escape }} }
\date{}

\begin{document}
\maketitle

\begin{abstract}
{{ draft.abstract_brief | latex_escape }}
\end{abstract}

{% if keywords %}
\noindent\textbf{Keywords:} {{ keywords | join(", ") | latex_escape }}
{% endif %}

{% for sec in draft.sections %}
\section{ {{ sec.name | latex_escape }} }
{{ sec.text }}

{% endfor %}

{% if has_bibliography %}
\printbibliography
{% endif %}

\end{document}

# ============================================================
# IntelliGen 环境变量配置模板
# 复制为 .env 并填入实际值: cp .env.example .env
# ============================================================

# ─── 数据库 ───
# Docker Compose 使用下方变量自动构建连接串，无需手动设置 DATABASE_URL。
# 本地开发可直接设置 DATABASE_URL 覆盖：
#   DATABASE_URL=postgresql+psycopg2://intelligen:intelligen123@localhost:5432/intelligen
POSTGRES_USER=intelligen
POSTGRES_PASSWORD=intelligen123
POSTGRES_DB=intelligen

# ─── JWT ───
# ⚠️ 生产环境必须修改！生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=24

# LLM Provider api_key 加密密钥 (Fernet)
# 留空则从 JWT_SECRET 稳定派生。若要独立管理:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=

# ─── LLM Providers（至少配置一个）───
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_CHAT_MODEL=qwen/qwen3-235b-a22b
LLM_FAST_MODEL=qwen/qwen3-30b-a3b
LLM_CODE_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=32768
LLM_TIMEOUT=300

# Embedding 模型（用于 RAG 向量化）
EMBEDDING_MODEL_NAME=./cache/huggingface/models--sentence-transformers--all-MiniLM-L6-v2

# DeepSeek（可选备选）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ─── 搜索 ───
SEARCH_MODEL_NAME=perplexity/sonar-pro
SERPAPI_KEY=
ACADEMIC_EMAIL=your-email@example.com
SEARCH_LIMIT=6

# ─── 日志 ───
LOG_LEVEL=info

# ─── 腾讯云 COS 存储（可选，默认使用本地存储）───
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai

# ─── 端口覆盖（可选）───
# WEB_PORT=9991
# API_PORT=9992
# ENGINE_PORT=9993
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# ─── 管理员（首次启动时通过 Setup 向导配置）───
# 若禁用向导，可在此设置自动创建管理员:
# SETUP_WIZARD=false
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=admin123

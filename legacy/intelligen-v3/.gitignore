# ============================================================
# IntelliGen - 根目录 .gitignore
# 提交现代化后的仓库结构
# ============================================================

# ── 排除根目录所有内容，然后白名单放行 ──
/*

# ── 白名单：保留当前根目录结构 ──
!apps/
!docs/
!legacy/
!infra/
!scripts/
!packages/
!package.json
!package-lock.json

# ── 保留 .gitignore 自身 ──
!.gitignore
!.github/
!docker-compose.yml
!.env.example
!README.md
!CHANGELOG.md

# ── 子目录通用排除 ──
# IDE / 编辑器
.cursor/
.idea/
*.iml
.vscode/

# 操作系统
.DS_Store
Thumbs.db

# 临时目录
tmp/
tmp_*

# Node.js
**/node_modules/

# ── 环境配置文件 (包含密钥，不提交) ──
.env
.env.*
packages/**/.env
packages/**/.env.*
!.env.example
!packages/**/.env.example

# ── 模型文件 ──
**/*.h5
**/tf_model.*

# ── 测试案例二进制文件（PDF/DOCX 太大不入库，只保留 README）──
docs/test-cases/*.pdf
docs/test-cases/*.docx

# ── Python ──
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/

# ── Java 构建产物 ──
**/target/

# ── 前端构建产物 ──
**/dist/

# ── 运行时数据 / 大文件产物 ──
**/uploads/
packages/api/data/indexes/
**/*.7z

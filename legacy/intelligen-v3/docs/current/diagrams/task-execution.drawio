<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <!-- Title -->
    <mxCell id="title" value="任务执行模型 (Task Execution &amp; Progress Streaming)" style="text;fontSize=18;fontStyle=1;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="80" y="10" width="640" height="30" as="geometry"/>
    </mxCell>

    <!-- Client -->
    <mxCell id="client" value="🖥️ Vue 3 前端" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="60" width="130" height="50" as="geometry"/>
    </mxCell>

    <!-- API Layer -->
    <mxCell id="api-box" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="190" y="50" width="170" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="api-title" value="API 层" style="text;fontSize=13;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333;" vertex="1" parent="1">
      <mxGeometry x="245" y="55" width="60" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="api-create" value="POST /sessions/{id}/tasks&#xa;创建生成任务" style="rounded=1;fillColor=#FFFFFF;strokeColor=#999;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="200" y="82" width="150" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="api-status" value="GET /tasks/{id}&#xa;查询任务状态" style="rounded=1;fillColor=#FFFFFF;strokeColor=#999;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="200" y="125" width="150" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="api-stream" value="GET /tasks/{id}/stream&#xa;SSE 实时进度" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="200" y="168" width="150" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="api-download" value="GET /tasks/{id}/download&#xa;下载报告" style="rounded=1;fillColor=#FFFFFF;strokeColor=#999;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="200" y="210" width="150" height="30" as="geometry"/>
    </mxCell>

    <!-- Service Layer -->
    <mxCell id="svc-box" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="400" y="50" width="170" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="svc-title" value="Service 层" style="text;fontSize=13;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#2d5a1e;" vertex="1" parent="1">
      <mxGeometry x="445" y="55" width="80" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="svc-task" value="TaskService&#xa;创建/查询/重试" style="rounded=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="410" y="82" width="150" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="svc-broker" value="TaskProgressBroker&#xa;pub/sub 进度分发" style="rounded=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="410" y="125" width="150" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="svc-session" value="SessionService&#xa;会话管理/鉴权" style="rounded=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="410" y="168" width="150" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="svc-file" value="FileService&#xa;附件存储" style="rounded=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="410" y="210" width="150" height="30" as="geometry"/>
    </mxCell>

    <!-- Runtime -->
    <mxCell id="rt-box" value="" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="610" y="50" width="170" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="rt-title" value="执行运行时" style="text;fontSize=13;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#7a5c00;" vertex="1" parent="1">
      <mxGeometry x="655" y="55" width="80" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="rt-ctrl" value="TaskRuntimeController&#xa;ThreadPoolExecutor" style="rounded=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="620" y="82" width="150" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="rt-bridge" value="GenerationBridge&#xa;IndexService + Pipeline" style="rounded=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="620" y="125" width="150" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="rt-pipeline" value="ReportPipeline&#xa;Plan→Retrieve→Write" style="rounded=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="620" y="168" width="150" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="rt-ckpt" value="SectionCheckpoint&#xa;增量断点保存" style="rounded=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="620" y="210" width="150" height="30" as="geometry"/>
    </mxCell>

    <!-- DB -->
    <mxCell id="db" value="🗄️ MySQL&#xa;Session / Task / Checkpoint" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="290" width="130" height="60" as="geometry"/>
    </mxCell>

    <!-- State Flow -->
    <mxCell id="state-box" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#ccc;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="290" width="370" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="state-title" value="任务状态机" style="text;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="140" y="293" width="80" height="18" as="geometry"/>
    </mxCell>
    <mxCell id="st-queued" value="QUEUED" style="rounded=1;fillColor=#e6e6e6;strokeColor=#999;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="30" y="318" width="65" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="st-run" value="RUNNING" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="115" y="318" width="65" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="st-done" value="COMPLETED" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="200" y="318" width="80" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="st-fail" value="FAILED" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="300" y="318" width="65" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="e-q-r" style="endArrow=classic;strokeColor=#333;strokeWidth=1.5;" edge="1" source="st-queued" target="st-run" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-r-d" style="endArrow=classic;strokeColor=#82b366;strokeWidth=1.5;" edge="1" source="st-run" target="st-done" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-r-f" style="endArrow=classic;strokeColor=#b85450;strokeWidth=1.5;" edge="1" source="st-run" target="st-fail" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Main edges -->
    <mxCell id="e-cli-api" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" source="client" target="api-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-api-svc" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" source="api-box" target="svc-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-svc-rt" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" source="svc-box" target="rt-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-svc-db" style="endArrow=classic;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;" edge="1" source="svc-box" target="db" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-rt-db" style="endArrow=classic;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;dashed=1;" edge="1" source="rt-box" target="db" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- SSE feedback arrow -->
    <mxCell id="e-broker-cli" value="SSE" style="endArrow=classic;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="svc-broker" target="client" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="170" y="142"/>
          <mxPoint x="170" y="115"/>
        </Array>
      </mxGeometry>
    </mxCell>
  </root>
</mxGraphModel>
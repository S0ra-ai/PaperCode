<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <!-- Title -->
    <mxCell id="title" value="反幻觉验证系统 (Anti-Hallucination Content Verification)" style="text;fontSize=18;fontStyle=1;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="60" y="10" width="680" height="30" as="geometry"/>
    </mxCell>

    <!-- Input -->
    <mxCell id="input-box" value="" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="20" y="60" width="200" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="input-title" value="LLM 章节生成输出" style="text;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#1a4472;" vertex="1" parent="1">
      <mxGeometry x="40" y="65" width="160" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="input-text" value="生成的章节文本&#xa;+ 引用标记 [1][2][3]" style="rounded=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="30" y="90" width="140" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="input-evidence" value="CitationRegistry&#xa;已注册的证据源" style="rounded=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="30" y="130" width="140" height="25" as="geometry"/>
    </mxCell>

    <!-- Step 1: Claim Extraction -->
    <mxCell id="extract-box" value="" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="260" y="55" width="200" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="extract-title" value="① Claim 提取" style="text;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#7a5c00;" vertex="1" parent="1">
      <mxGeometry x="310" y="60" width="120" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="extract-llm" value="独立 LLM 调用&#xa;(非自检 — 避免确认偏差)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="270" y="85" width="180" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="extract-claims" value="解析事实性断言&#xa;提取引用编号 [N]" style="rounded=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="270" y="122" width="180" height="35" as="geometry"/>
    </mxCell>

    <!-- Step 2: Evidence Mapping -->
    <mxCell id="map-box" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="500" y="55" width="200" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="map-title" value="② 证据映射" style="text;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#2d5a1e;" vertex="1" parent="1">
      <mxGeometry x="555" y="60" width="100" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="map-match" value="Claim [N] → 证据内容&#xa;语义对比" style="rounded=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="510" y="85" width="180" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="map-check" value="检查 [N] 是否真实存在&#xa;内容是否支持断言" style="rounded=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="510" y="122" width="180" height="35" as="geometry"/>
    </mxCell>

    <!-- Step 3: Classification -->
    <mxCell id="class-box" value="" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="140" y="210" width="520" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="class-title" value="③ 分类 — 每条 Claim 独立判定" style="text;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#5c3566;" vertex="1" parent="1">
      <mxGeometry x="260" y="215" width="260" height="20" as="geometry"/>
    </mxCell>
    
    <mxCell id="cl-supported" value="✅ SUPPORTED&#xa;证据充分支持" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="150" y="245" width="110" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="cl-hedged" value="🟡 HEDGED&#xa;保守表达可接受" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="275" y="245" width="110" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="cl-unsupported" value="⚠️ UNSUPPORTED&#xa;缺少证据" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="400" y="245" width="110" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="cl-fabricated" value="🚫 FABRICATED&#xa;编造 — 无对应源" style="rounded=1;fillColor=#FF0000;strokeColor=#8b0000;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="525" y="245" width="120" height="40" as="geometry"/>
    </mxCell>
    
    <mxCell id="class-arrow" value="→" style="text;fontSize=18;fillColor=none;strokeColor=none;fontColor=#999;" vertex="1" parent="1">
      <mxGeometry x="260" y="255" width="20" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="class-arrow2" value="→" style="text;fontSize=18;fillColor=none;strokeColor=none;fontColor=#999;" vertex="1" parent="1">
      <mxGeometry x="385" y="255" width="20" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="class-arrow3" value="→" style="text;fontSize=18;fillColor=none;strokeColor=none;fontColor=#999;" vertex="1" parent="1">
      <mxGeometry x="510" y="255" width="20" height="20" as="geometry"/>
    </mxCell>

    <!-- Score -->
    <mxCell id="score" value="trust_ratio = (supported + hedged) / total_claims" style="text;fontSize=11;fontStyle=3;fillColor=none;strokeColor=none;fontColor=#333;" vertex="1" parent="1">
      <mxGeometry x="200" y="295" width="400" height="18" as="geometry"/>
    </mxCell>

    <!-- Step 4: Action -->
    <mxCell id="action-box" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="140" y="345" width="520" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="action-title" value="④ 处置策略" style="text;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333;" vertex="1" parent="1">
      <mxGeometry x="340" y="350" width="120" height="20" as="geometry"/>
    </mxCell>
    
    <mxCell id="act-pass" value="高信任 (&gt;0.7)&#xa;保留原文&#xa;正常输出" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="155" y="380" width="145" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="act-strip" value="中信任 (0.4~0.7)&#xa;剥离编造引用&#xa;替换为保守表述" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="320" y="380" width="145" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="act-reject" value="低信任 (&lt;0.4)&#xa;拒绝输出&#xa;提示证据不足" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="490" y="380" width="145" height="55" as="geometry"/>
    </mxCell>

    <!-- Flow edges -->
    <mxCell id="e-in-ext" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" source="input-box" target="extract-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-ext-map" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" source="extract-box" target="map-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-map-cls" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" source="map-box" target="class-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-ext-cls" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" source="extract-box" target="class-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-cls-act" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" source="class-box" target="action-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
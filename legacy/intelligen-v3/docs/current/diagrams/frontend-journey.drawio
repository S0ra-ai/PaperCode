<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <!-- Title -->
    <mxCell id="title" value="前端交互流 (Frontend User Journey)" style="text;fontSize=18;fontStyle=1;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="120" y="10" width="560" height="30" as="geometry"/>
    </mxCell>

    <!-- User -->
    <mxCell id="user" value="👤 用户" style="shape=ellipse;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="30" y="180" width="80" height="60" as="geometry"/>
    </mxCell>

    <!-- Auth Flow -->
    <mxCell id="auth-box" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="150" y="55" width="140" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="auth-title" value="🔐 认证" style="text;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="185" y="58" width="70" height="18" as="geometry"/>
    </mxCell>
    <mxCell id="auth-login" value="登录 / 注册" style="rounded=1;fillColor=#FFFFFF;strokeColor=#999;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="160" y="80" width="120" height="25" as="geometry"/>
    </mxCell>
    <mxCell id="auth-cookie" value="httpOnly Cookie JWT" style="rounded=1;fillColor=#FFFFFF;strokeColor=#999;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="160" y="110" width="120" height="25" as="geometry"/>
    </mxCell>

    <!-- Session -->
    <mxCell id="session-box" value="" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="150" y="170" width="140" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="session-title" value="💬 会话管理" style="text;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#1a4472;" vertex="1" parent="1">
      <mxGeometry x="170" y="175" width="100" height="18" as="geometry"/>
    </mxCell>
    <mxCell id="session-create" value="创建/切换会话" style="rounded=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="160" y="198" width="120" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="session-history" value="历史会话列表" style="rounded=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="160" y="224" width="120" height="22" as="geometry"/>
    </mxCell>

    <!-- File Upload -->
    <mxCell id="file-box" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="150" y="275" width="140" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="file-title" value="📎 附件上传" style="text;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#2d5a1e;" vertex="1" parent="1">
      <mxGeometry x="175" y="280" width="90" height="18" as="geometry"/>
    </mxCell>
    <mxCell id="file-upload" value="拖拽/选择文件" style="rounded=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="160" y="302" width="120" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="file-types" value="PDF / DOCX / TXT" style="rounded=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="160" y="328" width="120" height="22" as="geometry"/>
    </mxCell>

    <!-- Task Creation -->
    <mxCell id="task-box" value="" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="340" y="120" width="170" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="task-title" value="🚀 任务创建" style="text;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#7a5c00;" vertex="1" parent="1">
      <mxGeometry x="383" y="125" width="90" height="18" as="geometry"/>
    </mxCell>
    <mxCell id="task-input" value="输入主题 + 模板选择" style="rounded=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="350" y="148" width="150" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="task-config" value="附件关联 + 参数配置" style="rounded=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="350" y="175" width="150" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="task-submit" value="POST /sessions/{id}/tasks" style="rounded=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="350" y="202" width="150" height="22" as="geometry"/>
    </mxCell>

    <!-- Real-time Progress -->
    <mxCell id="sse-box" value="" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="340" y="260" width="170" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="sse-title" value="📡 实时进度" style="text;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#8b0000;" vertex="1" parent="1">
      <mxGeometry x="383" y="265" width="90" height="18" as="geometry"/>
    </mxCell>
    <mxCell id="sse-connect" value="SSE 连接 /tasks/{id}/stream" style="rounded=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="350" y="288" width="150" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="sse-events" value="阶段进度 + 章节完成&#xa;心跳 + 状态变更" style="rounded=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="350" y="316" width="150" height="35" as="geometry"/>
    </mxCell>

    <!-- Preview & Download -->
    <mxCell id="preview-box" value="" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="560" y="120" width="200" height="170" as="geometry"/>
    </mxCell>
    <mxCell id="preview-title" value="📄 预览与下载" style="text;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#5c3566;" vertex="1" parent="1">
      <mxGeometry x="610" y="125" width="100" height="18" as="geometry"/>
    </mxCell>
    <mxCell id="preview-md" value="Markdown 实时预览" style="rounded=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="570" y="150" width="180" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="preview-cite" value="点击引用 → 证据侧栏" style="rounded=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="570" y="178" width="180" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="preview-ref" value="参考文献跳转 + 高亮" style="rounded=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="570" y="206" width="180" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="preview-dl" value="⬇️ 下载 MD / DOCX" style="rounded=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="570" y="238" width="180" height="28" as="geometry"/>
    </mxCell>

    <!-- Retry -->
    <mxCell id="retry" value="🔄 重试 / 章节重生成" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="570" y="310" width="180" height="30" as="geometry"/>
    </mxCell>

    <!-- Edges -->
    <mxCell id="e-user-auth" style="endArrow=classic;strokeColor=#333;strokeWidth=1.5;" edge="1" source="user" target="auth-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-user-session" style="endArrow=classic;strokeColor=#333;strokeWidth=1.5;" edge="1" source="user" target="session-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-user-file" style="endArrow=classic;strokeColor=#333;strokeWidth=1.5;" edge="1" source="user" target="file-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-session-task" style="endArrow=classic;strokeColor=#333;strokeWidth=2;fontStyle=1;" edge="1" source="session-box" target="task-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-file-task" style="endArrow=classic;strokeColor=#82b366;strokeWidth=1.5;dashed=1;" edge="1" source="file-box" target="task-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-task-sse" style="endArrow=classic;strokeColor=#b85450;strokeWidth=2;" edge="1" source="task-box" target="sse-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-task-preview" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" source="task-box" target="preview-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-sse-preview" style="endArrow=classic;strokeColor=#b85450;strokeWidth=1.5;dashed=1;" edge="1" source="sse-box" target="preview-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-retry-task" style="endArrow=classic;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;curved=1;" edge="1" source="retry" target="task-box" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="540" y="380"/>
          <mxPoint x="320" y="380"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Backend label -->
    <mxCell id="be-label" value="FastAPI 后端 (端口 9992)" style="text;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999;" vertex="1" parent="1">
      <mxGeometry x="380" y="395" width="180" height="18" as="geometry"/>
    </mxCell>
    <mxCell id="fe-label" value="Vue 3 前端 (端口 9991)" style="text;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999;" vertex="1" parent="1">
      <mxGeometry x="160" y="395" width="160" height="18" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
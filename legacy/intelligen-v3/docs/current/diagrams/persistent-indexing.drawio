<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <!-- Title -->
    <mxCell id="title" value="持久化 FAISS 索引 (Persistent Indexing Lifecycle)" style="text;fontSize=18;fontStyle=1;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="80" y="10" width="640" height="30" as="geometry"/>
    </mxCell>

    <!-- File Upload -->
    <mxCell id="upload" value="📄 用户上传附件&#xa;PDF / DOCX / TXT" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="70" width="150" height="50" as="geometry"/>
    </mxCell>

    <!-- Content Hash -->
    <mxCell id="hash-box" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="210" y="55" width="160" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="hash-title" value="内容哈希去重" style="text;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333;" vertex="1" parent="1">
      <mxGeometry x="230" y="60" width="120" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="hash-calc" value="SHA-256(file_bytes)&#xa;→ content_hash = doc_id" style="rounded=1;fillColor=#FFFFFF;strokeColor=#999;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="220" y="85" width="140" height="35" as="geometry"/>
    </mxCell>

    <!-- Decision: exists? -->
    <mxCell id="decision" value="索引已存在?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="420" y="65" width="120" height="60" as="geometry"/>
    </mxCell>

    <!-- YES path: Reuse -->
    <mxCell id="reuse" value="✅ 直接复用&#xa;跳过构建" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="590" y="55" width="120" height="45" as="geometry"/>
    </mxCell>

    <!-- NO path: Build pipeline -->
    <mxCell id="build-box" value="" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="200" y="175" width="410" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="build-title" value="索引构建流水线 (首次)" style="text;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#5c3566;" vertex="1" parent="1">
      <mxGeometry x="310" y="178" width="180" height="20" as="geometry"/>
    </mxCell>
    
    <mxCell id="build-parse" value="① 解析&#xa;PDF/DOCX→文本" style="rounded=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="210" y="205" width="90" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="build-chunk" value="② 切块&#xa;2000字/300重叠" style="rounded=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="310" y="205" width="90" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="build-embed" value="③ 嵌入&#xa;all-MiniLM-L6-v2" style="rounded=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="410" y="205" width="90" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="build-save" value="④ 持久化&#xa;原子写入磁盘" style="rounded=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="510" y="205" width="90" height="40" as="geometry"/>
    </mxCell>
    
    <mxCell id="build-atomic" value="原子写入: .tmp_{hash}_{pid}/ → rename → {hash}/" style="text;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#666;" vertex="1" parent="1">
      <mxGeometry x="260" y="255" width="300" height="18" as="geometry"/>
    </mxCell>

    <!-- Arrows in build -->
    <mxCell id="e-b1-b2" style="endArrow=classic;strokeColor=#9673a6;strokeWidth=1.5;" edge="1" source="build-parse" target="build-chunk" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-b2-b3" style="endArrow=classic;strokeColor=#9673a6;strokeWidth=1.5;" edge="1" source="build-chunk" target="build-embed" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-b3-b4" style="endArrow=classic;strokeColor=#9673a6;strokeWidth=1.5;" edge="1" source="build-embed" target="build-save" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Disk Storage -->
    <mxCell id="disk-box" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="200" y="320" width="410" height="85" as="geometry"/>
    </mxCell>
    <mxCell id="disk-title" value="📂 磁盘索引目录 {RAG_INDEX_DIR}/{content_hash}/" style="text;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#2d5a1e;" vertex="1" parent="1">
      <mxGeometry x="210" y="325" width="380" height="18" as="geometry"/>
    </mxCell>
    <mxCell id="disk-faiss" value="index.faiss&#xa;FAISS 向量索引" style="rounded=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="215" y="350" width="110" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="disk-chunks" value="chunks.json&#xa;块元数据" style="rounded=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="345" y="350" width="110" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="disk-info" value="info.json&#xa;创建时间/TTL" style="rounded=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="475" y="350" width="110" height="38" as="geometry"/>
    </mxCell>

    <!-- Query Flow -->
    <mxCell id="query-box" value="" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="200" y="440" width="410" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="query-title" value="查询流程 IndexService.query()" style="text;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#1a4472;" vertex="1" parent="1">
      <mxGeometry x="280" y="445" width="250" height="18" as="geometry"/>
    </mxCell>
    <mxCell id="query-load" value="加载 FAISS 索引" style="rounded=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="210" y="470" width="105" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="query-sim" value="相似度搜索 k=5" style="rounded=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="330" y="470" width="105" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="query-evi" value="→ EvidenceItem[]" style="rounded=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="450" y="470" width="105" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="e-ql-qs" style="endArrow=classic;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" source="query-load" target="query-sim" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-qs-qe" style="endArrow=classic;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" source="query-sim" target="query-evi" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- TTL Cleanup -->
    <mxCell id="ttl" value="🕐 TTL 清理: cleanup_expired()&#xa;默认 30 天过期" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="340" width="155" height="40" as="geometry"/>
    </mxCell>

    <!-- Main flow edges -->
    <mxCell id="e-up-hash" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" source="upload" target="hash-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-hash-dec" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" source="hash-box" target="decision" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-dec-yes" value="YES" style="endArrow=classic;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=10;" edge="1" source="decision" target="reuse" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-dec-no" value="NO" style="endArrow=classic;strokeColor=#b85450;strokeWidth=2;fontStyle=1;fontSize=10;" edge="1" source="decision" target="build-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-build-disk" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" source="build-box" target="disk-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-disk-query" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" source="disk-box" target="query-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-reuse-disk" style="endArrow=classic;strokeColor=#82b366;strokeWidth=1.5;dashed=1;curved=1;" edge="1" source="reuse" target="disk-box" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="680" y="320"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e-ttl-disk" style="endArrow=classic;strokeColor=#b85450;strokeWidth=1;dashed=1;" edge="1" source="ttl" target="disk-box" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
# ============================================================
# IntelliGen API Gateway — 本地开发环境变量
# 复制为 .env: cp .env.example .env
# Docker 部署无需此文件，由 docker-compose.yml 注入。
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://intelligen:intelligen123@localhost:5432/intelligen
# 或使用分拆变量（DATABASE_URL 优先）:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=intelligen
# DB_USERNAME=intelligen
# DB_PASSWORD=intelligen123

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication (Security-Critical) ---
# JWT secret for token signing. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secret-key-here       # ⚠️ MUST change in production
JWT_EXPIRATION_HOURS=24               # Token validity period

# --- Server ---
SERVER_PORT=9992                       # Backend API port

# --- Engine ---
ENGINE_BASE_URL=http://127.0.0.1:9993 # Docker 环境由 compose 覆盖为 http://engine:9993

# --- File Storage ---
FILE_STORAGE_PATH=./uploads            # Local file storage directory
FILE_PUBLIC_BASE_URL=http://127.0.0.1:9992  # Public URL prefix for file access

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:9991,http://127.0.0.1:9991

# --- Admin Bootstrap ---
# 首次启动默认使用 Setup 向导。禁用向导后可通过环境变量创建管理员:
# SETUP_WIZARD=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123      # ⚠️ Change immediately after first login
ADMIN_BOOTSTRAP_NICKNAME=管理员
ADMIN_BOOTSTRAP_EMAIL=admin@example.com

# --- LLM Configuration (OpenRouter) ---
OPENROUTER_API_KEY=                    # Your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary models (via OpenRouter)
LLM_CHAT_MODEL=qwen/qwen3-235b-a22b   # Heavy tasks: planning, writing, review
LLM_FAST_MODEL=qwen/qwen3-30b-a3b     # Light tasks: keywords, summary, clarification
LLM_TEMPERATURE=0.0                    # 0.0 = deterministic, 0.7 = creative
LLM_MAX_TOKENS=32768                   # Max response tokens per LLM call
LLM_TIMEOUT=300                        # API timeout in seconds

# --- Search & RAG ---
SEARCH_MODEL_NAME=perplexity/sonar-pro # Real-time academic search model
SERPAPI_KEY=                            # SerpAPI key for Google Scholar (optional)
ACADEMIC_EMAIL=                         # Email for Crossref polite pool (recommended)
SEARCH_LIMIT=10                        # Max search results per query

# --- Knowledge Base ---
KNOWLEDGE_DIR=./knowledge_base         # Local knowledge base directory
TEMPLATES_DIR=./templates              # Report template directory

# --- Tencent Cloud COS (File Storage) ---
COS_SECRET_ID=                         # ⚠️ NEVER commit real keys
COS_SECRET_KEY=                        # ⚠️ NEVER commit real keys
COS_BUCKET=
COS_REGION=ap-shanghai

# --- Logging ---
LOG_LEVEL=info                         # debug | info | warning | error

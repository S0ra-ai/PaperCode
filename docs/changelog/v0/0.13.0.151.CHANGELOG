            - targeted tests: packages/opencode strict-acceptance.test
            - docs check: scripts/check-development-docs.ps1 -Render
            - strict acceptance: scripts/strict-acceptance.ps1 -CheckTimeoutSeconds 900
            - audit: scripts/autonomous-product-audit.ps1 -AllowActiveTask
